{
  "name": "whaleagent",
  "version": "0.13.0",
  "private": true,
  "description": "Standalone Bilibili reading assistant for Windows",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack:win": "node scripts/pack-win.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "publish:release": "node scripts/pack-release.mjs --publish --notes-file release-notes.md",
    "smoke:update": "node scripts/update-apply-smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^37.2.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
